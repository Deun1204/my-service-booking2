{
  "entities": {
    "Reservation": {
      "title": "Reservation",
      "description": "Company meeting room or shared equipment reservation record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the reservation",
          "maxLength": 64
        },
        "resourceId": {
          "type": "string",
          "description": "Identifier of the reserved room or asset",
          "maxLength": 64
        },
        "resourceName": {
          "type": "string",
          "description": "Name of the reserved room or asset",
          "maxLength": 100
        },
        "location": {
          "type": "string",
          "description": "Floor or zone location of the resource",
          "maxLength": 100
        },
        "date": {
          "type": "string",
          "description": "Reserved date string",
          "maxLength": 30
        },
        "startTime": {
          "type": "string",
          "description": "Start time in HH:mm",
          "maxLength": 10,
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "endTime": {
          "type": "string",
          "description": "End time in HH:mm",
          "maxLength": 10,
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "purpose": {
          "type": "string",
          "description": "Meeting or reservation purpose",
          "maxLength": 200
        },
        "userName": {
          "type": "string",
          "description": "Name of the person reserving",
          "maxLength": 50
        },
        "userDept": {
          "type": "string",
          "description": "Department of the person reserving",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "description": "Current status of the reservation",
          "enum": ["in_progress", "reserved", "completed", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when reservation was created",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when reservation was last updated",
          "maxLength": 50
        }
      },
      "required": ["resourceId", "resourceName", "date", "startTime", "endTime", "status", "createdAt"]
    }
  },
  "firestore": {
    "/reservations/{reservationId}": {
      "schema": "Reservation",
      "description": "Company meeting rooms and asset equipment reservations"
    }
  }
}
